# Database (PostgreSQL — Supabase, Railway, or local)
DATABASE_URL="postgresql://user:password@host:5432/dbname"
DIRECT_URL="postgresql://user:password@host:5432/dbname"

# Auth.js session secret (either name works). Generate with: openssl rand -base64 32
AUTH_SECRET="generate-a-random-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# Signs submission receipts. Required in production; changing it invalidates old receipts.
JWT_SECRET="generate-another-random-secret-here"
