generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  INNOVATOR
  EVALUATOR
  ADJUDICATOR
  ADMIN
  SUPERADMIN
}

/// Venture stage (rows of the classification matrix).
enum Scale {
  SCALE_1
  SCALE_2
  SCALE_3
  SCALE_4
  SCALE_5
  SCALE_6
}

/// Sector (columns of the classification matrix).
enum DataType {
  TYPE_A
  TYPE_B
  TYPE_C
  TYPE_D
  TYPE_E
  TYPE_F
}

/// Lifecycle of an idea instance: Submitted -> Review -> Feedback -> Approval -> Award.
enum InstanceStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  SHORTLISTED
  FLAGGED
  APPROVED
  AWARDED
  REJECTED
}

enum CallStatus {
  DRAFT
  OPEN
  CLOSED
}

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  passwordHash      String
  name              String
  role              Role      @default(INNOVATOR)
  phone             String?
  /// Omang (national ID) number, used for the citizenship check.
  omang             String?
  dateOfBirth       DateTime?
  gender            String?
  district          String?
  /// Company the innovator applies through.
  organizationName  String?
  /// CIPA company registration number.
  licenseNumber     String?
  /// Percentage of the company held by citizens aged 18-35.
  youthShareholding Int?
  /// Evaluator / adjudicator area of expertise.
  expertise         String?
  /// When the user accepted the privacy notice (Data Protection Act 2024).
  consentAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  instances         Instance[]     @relation("InnovatorInstances")
  reviewedInstances Instance[]     @relation("ReviewedInstances")
  createdTemplates  Template[]
  evaluations       Evaluation[]   @relation("EvaluatorEvaluations")
  messages          Message[]
  auditLogs         AuditLog[]
  notifications     Notification[]
}

/// A call for ideas. Its schema holds the application form and the scoring rubric.
model Template {
  id               String     @id @default(cuid())
  code             String     @unique
  name             String
  description      String?
  scale            Scale
  dataType         DataType
  /// { fields: [...], required_files: [...], criteria: [{ key, label, weight, guide }] }
  schema           Json
  status           CallStatus @default(OPEN)
  opensAt          DateTime   @default(now())
  closesAt         DateTime
  /// What winners receive, e.g. "Up to P250,000 grant + 6 months incubation".
  fundingSummary   String?
  /// Evaluators per idea.
  reviewersPerIdea Int        @default(2)
  createdById      String
  createdBy        User       @relation(fields: [createdById], references: [id])
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  instances Instance[]
}

/// One idea submitted to a call: a sealed, versioned container of answers and files.
model Instance {
  id              String         @id @default(cuid())
  /// Public reference for tracking, e.g. CEDA-26-4F7Q.
  referenceCode   String         @unique
  title           String
  templateId      String
  template        Template       @relation(fields: [templateId], references: [id])
  innovatorId     String
  innovator       User           @relation("InnovatorInstances", fields: [innovatorId], references: [id])
  status          InstanceStatus @default(DRAFT)
  deadline        DateTime
  encryptionKey   String
  submissionJwt   String?
  /// SHA-256 of the canonical field data, bound into the signed receipt.
  dataHash        String?
  submissionCount Int            @default(0)
  /// Latest feedback or decision reason shown to the innovator.
  reviewNotes     String?
  reviewedById    String?
  reviewedBy      User?          @relation("ReviewedInstances", fields: [reviewedById], references: [id])
  awardAmount     Int?
  createdAt       DateTime       @default(now())
  submittedAt     DateTime?
  reviewedAt      DateTime?

  files       InstanceFile[]
  fields      InstanceField[]
  evaluations Evaluation[]
  messages    Message[]
  audits      AuditLog[]

  @@index([status])
}

model InstanceFile {
  id            String   @id @default(cuid())
  instanceId    String
  instance      Instance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  fileKey       String
  fileName      String
  fileExtension String
  mimeType      String   @default("application/octet-stream")
  fileSize      Int
  clientHash    String
  serverHash    String
  /// File bytes live in the database so uploads survive serverless redeploys.
  content       Bytes
  uploadedAt    DateTime @default(now())

  @@unique([instanceId, fileKey])
}

model InstanceField {
  id          String    @id @default(cuid())
  instanceId  String
  instance    Instance  @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  fieldKey    String
  fieldValue  String
  validatedAt DateTime?
}

/// One evaluator's scorecard for one idea.
model Evaluation {
  id           String    @id @default(cuid())
  instanceId   String
  instance     Instance  @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  evaluatorId  String
  evaluator    User      @relation("EvaluatorEvaluations", fields: [evaluatorId], references: [id])
  assignedById String
  assignedAt   DateTime  @default(now())
  dueAt        DateTime
  /// null until declared. true = conflict, evaluator steps aside.
  conflict     Boolean?
  conflictNote String?
  /// { criterionKey: 1-5 }
  scores       Json?
  /// Weighted score out of 100.
  total        Float?
  /// Shared with the innovator (anonymised).
  feedback     String?
  /// Only seen by CEDA staff and the panel.
  privateNote  String?
  submittedAt  DateTime?

  @@unique([instanceId, evaluatorId])
  @@index([evaluatorId, submittedAt])
}

/// Clarification thread on an idea. Internal messages are never shown to the innovator.
model Message {
  id         String   @id @default(cuid())
  instanceId String
  instance   Instance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  authorId   String
  author     User     @relation(fields: [authorId], references: [id])
  body       String
  internal   Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([instanceId, createdAt])
}

model AuditLog {
  id         String    @id @default(cuid())
  actorId    String
  actor      User      @relation(fields: [actorId], references: [id])
  action     String
  instanceId String?
  instance   Instance? @relation(fields: [instanceId], references: [id], onDelete: SetNull)
  metadata   Json?
  createdAt  DateTime  @default(now())

  @@index([createdAt])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
}
